# Production web and worker. Use different random values in each environment.
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
DIRECT_DATABASE_URL=
# Comma-separated keyId:base64url key entries, newest first. Each key must contain 32 bytes.
QR_KEYS=
# Long independent random key for administrative TOTP secrets and indexed rate-limit keys.
APP_SECRET=
# Browser-visible address of the realtime companion. Use wss:// for HTTPS deployments.
REALTIME_URL=ws://localhost:3001/live
WORKER_PORT=3001
# Direct, non-transaction-pooled PostgreSQL connection for LISTEN/NOTIFY.
LISTEN_DATABASE_URL=
# Optional SMTP, OAuth and Web Push integrations.
SMTP_URL=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional trusted reverse proxy. Enable only if the edge overwrites this single-IP header.
TRUSTED_IP_HEADER=
# Development-only fixtures must be enabled explicitly for PostgreSQL.
ALLOW_DEMO_SEED=

# Previous encryption key during a planned rotation only.
APP_PREVIOUS_SECRET=
# Optional institution font for PDF report scripts outside the bundled fonts.
REPORT_FONT_PATH=
