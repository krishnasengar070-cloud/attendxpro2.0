{
  "name": "attendx-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <27"
  },
  "scripts": {
    "local": "node --env-file-if-exists=.env scripts/local.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node --test tests/browser.spec.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "migrate": "prisma migrate deploy",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "provision": "node --env-file-if-exists=.env scripts/provision.mjs",
    "worker": "node --env-file-if-exists=.env scripts/worker.mjs",
    "mail": "node scripts/mail.mjs",
    "rotate:totp": "node --env-file-if-exists=.env scripts/rotate-totp.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "pg": "^8.16.3",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.548.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "nodemailer": "^7.0.11",
    "web-push": "^3.6.7",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "postcss": "^8.5.0",
    "prisma": "^7.0.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.56.0"
  }
}
